@article{marianski_remote_2020,
	title = {Remote Participation during Glycosylation Reactions of Galactose Building Blocks: Direct Evidence from Cryogenic Vibrational Spectroscopy},
	volume = {59},
	rights = {© 2020 The Authors. Published by Wiley-{VCH} Verlag {GmbH} \& Co. {KGaA}.},
	issn = {1521-3773},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/anie.201916245},
	doi = {10.1002/anie.201916245},
	shorttitle = {Remote Participation during Glycosylation Reactions of Galactose Building Blocks},
	abstract = {The stereoselective formation of 1,2-cis-glycosidic bonds is challenging. However, 1,2-cis-selectivity can be induced by remote participation of C4 or C6 ester groups. Reactions involving remote participation are believed to proceed via a key ionic intermediate, the glycosyl cation. Although mechanistic pathways were postulated many years ago, the structure of the reaction intermediates remained elusive owing to their short-lived nature. Herein, we unravel the structure of glycosyl cations involved in remote participation reactions via cryogenic vibrational spectroscopy and first principles theory. Acetyl groups at C4 ensure α-selective galactosylations by forming a covalent bond to the anomeric carbon in dioxolenium-type ions. Unexpectedly, also benzyl ether protecting groups can engage in remote participation and promote the stereoselective formation of 1,2-cis-glycosidic bonds.},
	pages = {6166--6171},
	number = {15},
	journaltitle = {Angewandte Chemie International Edition},
	author = {Marianski, Mateusz and Mucha, Eike and Greis, Kim and Moon, Sooyeon and Pardo, Alonso and Kirschbaum, Carla and Thomas, Daniel A. and Meijer, Gerard and von Helden, Gert and Gilmore, Kerry and Seeberger, Peter H. and Pagel, Kevin},
	urldate = {2026-04-09},
	date = {2020},
	langid = {english},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/anie.201916245},
	keywords = {glycosyl cations, glycosylation, mass spectrometry, reaction Intermediates, spectroscopy},
	file = {Full Text PDF:/home/eugene/Zotero/storage/TR2984RE/Marianski et al. - 2020 - Remote Participation during Glycosylation Reactions of Galactose Building Blocks Direct Evidence fr.pdf:application/pdf;Snapshot:/home/eugene/Zotero/storage/U6BSARUS/anie.html:text/html},
}

@article{hansen_characterization_2020,
	title = {Characterization of glycosyl dioxolenium ions and their role in glycosylation reactions},
	volume = {11},
	rights = {2020 The Author(s)},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/s41467-020-16362-x},
	doi = {10.1038/s41467-020-16362-x},
	abstract = {Controlling the chemical glycosylation reaction remains the major challenge in the synthesis of oligosaccharides. Though 1,2-trans glycosidic linkages can be installed using neighboring group participation, the construction of 1,2-cis linkages is difficult and has no general solution. Long-range participation ({LRP}) by distal acyl groups may steer the stereoselectivity, but contradictory results have been reported on the role and strength of this stereoelectronic effect. It has been exceedingly difficult to study the bridging dioxolenium ion intermediates because of their high reactivity and fleeting nature. Here we report an integrated approach, using infrared ion spectroscopy, {DFT} computations, and a systematic series of glycosylation reactions to probe these ions in detail. Our study reveals how distal acyl groups can play a decisive role in shaping the stereochemical outcome of a glycosylation reaction, and opens new avenues to exploit these species in the assembly of oligosaccharides and glycoconjugates to fuel biological research.},
	pages = {2664},
	number = {1},
	journaltitle = {Nature Communications},
	shortjournal = {Nat Commun},
	publisher = {Nature Publishing Group},
	author = {Hansen, Thomas and Elferink, Hidde and van Hengst, Jacob M. A. and Houthuijs, Kas J. and Remmerswaal, Wouter A. and Kromm, Alexandra and Berden, Giel and van der Vorm, Stefan and Rijs, Anouk M. and Overkleeft, Hermen S. and Filippov, Dmitri V. and Rutjes, Floris P. J. T. and van der Marel, Gijsbert A. and Martens, Jonathan and Oomens, Jos and Codée, Jeroen D. C. and Boltje, Thomas J.},
	urldate = {2026-04-09},
	date = {2020-05-29},
	langid = {english},
	keywords = {Carbohydrate chemistry, Computational chemistry, Reaction mechanisms},
	file = {Full Text PDF:/home/eugene/Zotero/storage/ESJX6XNY/Hansen et al. - 2020 - Characterization of glycosyl dioxolenium ions and their role in glycosylation reactions.pdf:application/pdf},
}

@article{chatterjee_empirical_2018,
	title = {An Empirical Understanding of the Glycosylation Reaction},
	volume = {140},
	issn = {0002-7863},
	url = {https://doi.org/10.1021/jacs.8b04525},
	doi = {10.1021/jacs.8b04525},
	abstract = {Reliable glycosylation reactions that allow for the stereo- and regioselective installation of glycosidic linkages are paramount to the chemical synthesis of glycan chains. The stereoselectivity of glycosylations is exceedingly difficult to control due to the reaction’s high degree of sensitivity and its shifting, simultaneous mechanistic pathways that are controlled by variables of unknown degree of influence, dominance, or interdependency. An automated platform was devised to quickly, reproducibly, and systematically screen glycosylations and thereby address this fundamental problem. Thirteen variables were investigated in as isolated a manner as possible, to identify and quantify inherent preferences of electrophilic glycosylating agents (glycosyl donors) and nucleophiles (glycosyl acceptors). Ways to enhance, suppress, or even override these preferences using judicious environmental conditions were discovered. Glycosylations involving two specific partners can be tuned to produce either 11:1 selectivity of one stereoisomer or 9:1 of the other by merely changing the reaction conditions.},
	pages = {11942--11953},
	number = {38},
	journaltitle = {Journal of the American Chemical Society},
	shortjournal = {J. Am. Chem. Soc.},
	publisher = {American Chemical Society},
	author = {Chatterjee, Sourav and Moon, Sooyeon and Hentschel, Felix and Gilmore, Kerry and Seeberger, Peter H.},
	urldate = {2026-04-09},
	date = {2018-09-26},
	file = {Full Text PDF:/home/eugene/Zotero/storage/DNRPE672/Chatterjee et al. - 2018 - An Empirical Understanding of the Glycosylation Reaction.pdf:application/pdf},
}

@article{schlegel_exploring_2003,
	title = {Exploring potential energy surfaces for chemical reactions: An overview of some practical methods},
